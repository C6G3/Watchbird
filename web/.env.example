# Copy to .env.local. Leave the Supabase values empty to run in demo mode
# (synthetic data, no login needed, nothing is saved).

# Supabase -> Project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the scan route to write results; never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Vision AI provider (Hugging Face or any OpenAI-compatible provider like Groq or Gemini)
# Hugging Face: https://huggingface.co/settings/tokens ("Make calls to Inference Providers")
# Free alternatives: Groq (https://console.groq.com) or Google AI Studio (https://aistudio.google.com)
HF_TOKEN=
# Vision-language model that writes the farmer-facing insight.
# HF default: Qwen/Qwen2.5-VL-7B-Instruct
# Free Groq: llama-3.2-11b-vision-preview
# Free Gemini: gemini-1.5-flash
HF_VISION_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
# Optional endpoint override for free OpenAI-compatible providers:
# For Groq: https://api.groq.com/openai/v1
# For Gemini: https://generativelanguage.googleapis.com/v1beta/openai
HF_BASE_URL=
# Optional plant-disease classifier whose top labels are passed to the VLM as a hint (Hugging Face only).
HF_PLANT_CLASSIFIER=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# ml/service.py (FastAPI). Admin "Train" and "Run detection" buttons call it.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_SECRET=
