# Python side: bridge.py, train.py, ml/service.py. Copy to .env (git-ignored).
SUPABASE_URL=
# Service-role key (Project settings -> API). Server-side only, never ship to a browser or ESP32.
SUPABASE_SERVICE_ROLE_KEY=
# Shared with web/.env.local so only the web app can trigger jobs.
ML_SERVICE_SECRET=
# ml/service.py extras (both optional locally; render.yaml turns them on)
RUN_BRIDGE=0
MONITOR_INTERVAL_MIN=0
